# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit ไฟล์ .env)

# Flask
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=network_monitor.db

# บัญชีผู้ดูแลเริ่มต้น (ถูกสร้างครั้งแรกที่รันระบบ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# การตรวจสอบ
CHECK_INTERVAL_SECONDS=60
PING_TIMEOUT_SECONDS=2
PORT_TIMEOUT_SECONDS=1.5
HTTP_TIMEOUT_SECONDS=5
LOG_RETENTION_DAYS=90

# แจ้งเตือน (เว้นว่างไว้หากไม่ใช้)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
